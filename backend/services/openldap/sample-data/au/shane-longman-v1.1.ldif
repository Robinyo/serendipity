# Sample LDIF — OpenLDAP serendipity backend, People branch (ou=people)
#
# Intended for: OpenLDAP (osixia/openldap) + Keycloak LDAP User Federation development.
# Document: website/docs/try-install-upgrade/sample-data/configure.md
#            website/docs/administration-guide/user-provisioning.md (LDAP federation section)
#
# Conventions:
#  - uid        = login name (Keycloak pairs uid with cn to form display name)
#  - cn        = full common name (character name from Capital City)
#  - givenName / sn = first / last name (character's first/last name)
#  - title     = job / functional title (the character's role in the series)
#  - department = functional department (the dealing room desk / division)
#  - mail      = email address (derived from uid, shanelongman.co.uk domain for London users,
#                  shanelongman.com.au for Australian users — reflecting the lobbying firm's AU clients)
#  - telephoneNumber = phone
#  - manager   = LDAP DN of the user's manager (STANDARD LDAP relationship attribute)
#  - serendipitySub = Pre-computed Keycloak sub (UUID) — used at import time to resolve
#                     the manager DN → the manager's Keycloak sub (Option A: resolve at import)
#  - directoryObjectId = User's own LDAP DN — source-correlation attribute mapped into
#                        Keycloak's directoryObjectId custom attribute at federation
#  - c / l / st = geographic attributes (country / locality / state) — REPORTING ONLY at this point
#                 (no geographic access-control scope in the model)
#
# NOTE: the <name>SerendipitySub attributes (e.g. jamesFarrellSerendipitySub) hold each user's OWN
# sub, so that the import-time resolver can look up "which user owns this DN, and what is their sub?"
# when resolving a direct report's manager. The manager's DN in the 'manager' attribute is looked up
# by matching it to a user's directoryObjectId (their own DN), then reading that user's <name>SerendipitySub.
#
# Root DIT:
#   dc=shane-longman,dc=org
#   ├── ou=people
#   └── ou=groups
#
# =============================================================================
# Sample organisation: Shane Longman — a fictional international bank based in the City of London,
# the setting of the 1989 British TV series "Capital City" (ITV / Euston Films).
# In the Serendipity sample, Shane Longman is a political lobbying organisation whose customers are
# the Australian political parties seeded in the Party Service's sample-data.
# The sample users are the character names from Capital City (not the actors' real names).
#
# Role model: consulting / advisory-firm tiers (NOT sales roles).
#   partner          -> James Farrell (CEO)
#   senior-manager   -> Lee Wolf, Leonard Ansen
#   manager          -> Max Lubin, Wendy Foley
#   consultant       -> Declan McConnachie, Sirkka Nieminen, Michelle Hauptmann,
#                       Hudson Talbot, Hannah Burgess
#   analyst          -> Chas Ewell, Hilary Rollinger
#
# Manager hierarchy:
#   James Farrell (CEO, partner) — top of hierarchy, no manager
#     ├── Lee Wolf (Director of Corporate Finance, senior-manager)
#     └── Leonard Ansen (Director of Banking Activities, senior-manager)
#           ├── Max Lubin (Head of Swaps, manager)
#           ├── Wendy Foley (Chief Trader / Head of Derivatives, manager)
#           ├── Declan McConnachie (Senior Trader — secondary desk, consultant)
#           ├── Sirkka Nieminen (Senior Trader — secondary desk, consultant)
#           ├── Michelle Hauptmann (Senior Trader — primary desk, consultant)
#           ├── Chas Ewell (Junior Trader — primary desk, analyst)
#           ├── Hudson Talbot (Capital Markets Originator, consultant)
#           ├── Hannah Burgess (Dealing Room IT, consultant) — Canberra
#           └── Hilary Rollinger (Graduate Assistant, analyst) — Canberra
#
# Geographic spread:
#   London users:    c=UK, l=London,     st=Greater London
#   Sydney users:    c=AU, l=Sydney,     st=NSW
#   Canberra users:  c=AU, l=Canberra,   st=ACT
# =============================================================================

## ---------------------------------------------------------------------------
## Branch entries
## ---------------------------------------------------------------------------

# Top-level branches of the shane-longman DIT.
# ou=people holds all user entries; ou=groups holds the sample consultative practice groups.
# Neither branch carries a manager — they are structural, not reporting-line entries.

dn: ou=people,dc=shane-longman,dc=org
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=shane-longman,dc=org
objectClass: organizationalUnit
ou: groups

## ---------------------------------------------------------------------------
## Users
## ---------------------------------------------------------------------------

# James Farrell — Chief Executive Officer (CEO)
#   Role in the series: the head of Shane Longman, the fictional international bank.
#   Keycloak role tier: partner (co-owner / senior executive).
#   Reports to: nobody — top of hierarchy.
#   Geographic: London, Greater London, UK.
#   Note: the CEO is a co-owner of the firm; revenue generation, strategic client account
#   management, firm governance, and practice development are his remit. He has no manager.

dn: uid=james.farrell,ou=people,dc=shane-longman,dc=org
