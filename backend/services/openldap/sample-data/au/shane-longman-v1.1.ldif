## ---------------------------------------------------------------------------
## Groups (sample — consultative practice areas, not access-control scopes)
## ---------------------------------------------------------------------------

# Political advisory practice — the practice area led by Lee Wolf (Director of Political
# Advisory). Members: Lee Wolf (practice leader), Declan McConnachie and Sirkka Nieminen
# (senior consultants), and Chas Ewell (junior trader / entry-level). This is a sample group
# for team-based authorization demonstration — it is not an access-control scope in the Serendipity
# model (the model uses manager-as-sub, roles, and ownedBy/assignedTo; groups are additive).

dn: cn=serendipity-practice-political-advisory,ou=groups,dc=shane-longman,dc=org
objectClass: groupOfNames
cn: serendipity-practice-political-advisory
description: Political advisory practice — Shane Longman
member: uid=lee.wolf,ou=people,dc=shane-longman,dc=org
member: uid=declan.mcconnachie,ou=people,dc=shane-longman,dc=org
member: uid=sirkka.nieminen,ou=people,dc=shane-longman,dc=org
member: uid=chas.ewell,ou=people,dc=shane-longman,dc=org

# Corporate finance practice — the practice area led by Leonard Ansen (Director of Banking
# Activities). Members: Leonard Ansen (practice leader), Max Lubin and Wendy Foley (desk heads),
# Michelle Hauptmann, Hudson Talbot, and Hannah Burgess (consultants), and Hilary Rollinger
# (graduate assistant). This is the dealing room's corporate finance side — swaps, derivatives,
# capital markets, IT, and the graduate assistant. Sample group for team-based authorization
# demonstration — not an access-control scope in the Serendipity model.

dn: cn=serendipity-practice-corporate-finance,ou=groups,dc=shane-longman,dc=org
objectClass: groupOfNames
cn: serendipity-practice-corporate-finance
description: Corporate finance practice — Shane Longman
member: uid=leonard.ansen,ou=people,dc=shane-longman,dc=org
member: uid=max.lubin,ou=people,dc=shane-longman,dc=org
