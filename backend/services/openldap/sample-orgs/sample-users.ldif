objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
objectClass: top
uid: carl.smith
cn: Carl Smith
givenName: Carl
sn: Smith
mail: carl.smith@mesg.com.au
telephoneNumber: +61-400-000-001
title: Sales Director
department: Sales
userPassword: {SSHA}...encrypted...
directoryObjectId: uid=carl.smith,ou=people,dc=serendipity,dc=org
carlSmithSerendipitySub: 4f5a1c2e-3b6d-4a7e-9c01-2d3f4a5b6c7d
c: AU
l: Melbourne
st: VIC

