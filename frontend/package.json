{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "husky",
    "format": "prettier --write .",
    "lint": "ng lint",
    "build": "ng build",
    "build:all-libs": "ng build serendipity-utils-lib && ng build serendipity-auth-lib && ng build serendipity-party-lib && ng build serendipity-components-lib && ng build serendipity-camunda-lib && ng build serendipity-workflow-lib",
    "build:pwa:prod": "npm run build:all-libs && ng build serendipity-pwa --configuration production",
    "clean": "rimraf dist",
    "watch": "npm-run-all clean --parallel watch-lib:*",
    "start": "ng serve",
    "test": "ng test"
  },
  "lint-staged": {
    "*.{html,js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,scss}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@bluehalo/ngx-leaflet": "^22.0.0",
    "@bpmn-io/form-js-viewer": "^1.24.0",
    "bpmn-js": "^18.22.1",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@types/leaflet": "^1.9.22",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "ng-packagr": "^22.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.7",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.8"
  }
}
