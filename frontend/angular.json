{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "serendipity-pwa": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/serendipity-pwa",
      "sourceRoot": "projects/serendipity-pwa/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/serendipity-pwa/src/main.ts",
            "tsConfig": "projects/serendipity-pwa/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/serendipity-pwa/src/favicon.ico",
              "projects/serendipity-pwa/src/assets",
              {
                "glob": "**/*",
                "input": "projects/serendipity-party-lib/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "projects/serendipity-workflow-lib/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "projects/serendipity-utils-lib/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/leaflet/dist/images",
                "output": "leaflet/"
              }
            ],
            "styles": [
              "projects/serendipity-pwa/src/styles.scss",
              "projects/serendipity-pwa/src/theme.scss",
              "projects/serendipity-components-lib/src/styles.scss",
              "./node_modules/@bpmn-io/form-js-viewer/dist/assets/form-js.css",
              "./node_modules/leaflet/dist/leaflet.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/serendipity-pwa/src/environments/environment.ts",
                  "with": "projects/serendipity-pwa/src/environments/environment.development.ts"
                }
              ]
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "assets": [
                "projects/serendipity-pwa/src/favicon.ico",
                "projects/serendipity-pwa/src/assets",
                {
                  "glob": "**/*",
                  "input": "projects/serendipity-party-lib/src/assets",
                  "output": "/assets"
                }
              ],
              "styles": [
                "projects/serendipity-pwa/src/styles.scss",
                "projects/serendipity-pwa/src/theme.scss",
                "projects/serendipity-components-lib/src/styles.scss"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "serendipity-pwa:build:production"
            },
            "development": {
              "buildTarget": "serendipity-pwa:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/serendipity-pwa/tsconfig.json",
            "buildTarget": "serendipity-pwa:build:development",
            "runner": "vitest",
            "providersFile": "projects/serendipity-pwa/test-providers.ts"
          }
        }
      }
    },
    "serendipity-utils-lib": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/serendipity-utils-lib",
      "sourceRoot": "projects/serendipity-utils-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/serendipity-utils-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/serendipity-utils-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/serendipity-utils-lib/tsconfig.spec.json"
          }
        }
      }
    },
    "serendipity-components-lib": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/serendipity-components-lib",
      "sourceRoot": "projects/serendipity-components-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/serendipity-components-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/serendipity-components-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/serendipity-components-lib/tsconfig.spec.json"
          }
        }
      }
    },
    "serendipity-party-lib": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/serendipity-party-lib",
      "sourceRoot": "projects/serendipity-party-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/serendipity-party-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/serendipity-party-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/serendipity-party-lib/tsconfig.json",
            "buildTarget": "serendipity-pwa:build:development",
            "runner": "vitest",
            "providersFile": "projects/serendipity-pwa/test-providers.ts"
          }
        }
      }
    },
    "serendipity-workflow-lib": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/serendipity-workflow-lib",
      "sourceRoot": "projects/serendipity-workflow-lib/src",
      "prefix": "workflow",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/serendipity-workflow-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/serendipity-workflow-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/serendipity-workflow-lib/tsconfig.spec.json"
          }
        }
      }
    },
    "serendipity-auth-lib": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/serendipity-auth-lib",
      "sourceRoot": "projects/serendipity-auth-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/serendipity-auth-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/serendipity-auth-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/serendipity-auth-lib/tsconfig.spec.json"
          }
        }
      }
    },
    "serendipity-camunda-lib": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/serendipity-camunda-lib",
      "sourceRoot": "projects/serendipity-camunda-lib/src",
      "prefix": "camunda",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/serendipity-camunda-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/serendipity-camunda-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/serendipity-camunda-lib/tsconfig.spec.json"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
